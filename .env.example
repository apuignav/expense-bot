# Copy to .env and adjust. Docker Compose reads it for variable interpolation.

# Bot configuration YAML (copy of .expensebotrc.example, filled in). Keep mode 600.
EXPENSEBOT_CONFIG_FILE=/path/to/expensebot.yaml

# Directory for mutable state (must be writable by PUID:PGID).
EXPENSEBOT_DATA_DIR=/path/to/expense-bot-data

# User and group the container runs as.
PUID=10001
PGID=10001

# Timezone.
TZ=Europe/Zurich
